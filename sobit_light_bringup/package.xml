<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobit_light_bringup</name>
  <version>2.0.0</version>
  <description>SOBIT LIGHT bringup launchers</description>
  <maintainer email="kvalentincardenas@hotmail.com">Keith Valentin</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>

  <depend>controller_manager</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>velocity_controllers</depend>
  <depend>position_controllers</depend>
  <depend>diff_drive_controller</depend>
  <depend>tf2_ros</depend>

  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_sim</depend>
  <depend>image_transport</depend>
  <depend>compressed_image_transport</depend>
  <depend>compressed_depth_image_transport</depend>
  <depend>depth_image_proc</depend>

  <depend>sobit_light_description</depend>
  <depend>sobit_light_control</depend>
  <!-- Viewers enable_viz picks from; each is optional at runtime. -->
  <exec_depend>sobits_viz_rviz</exec_depend>
  <exec_depend>sobits_viz_foxglove</exec_depend>
  <exec_depend>sobits_viz_rerun</exec_depend>

  <!-- Launch-time only: nodes, includes and worlds started by robot.launch.py / <sim>_minimal.launch.py. -->
  <exec_depend>sobit_light_library</exec_depend>
  <exec_depend>sobit_light_moveit_config</exec_depend>
  <exec_depend>twist_stamper</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>mujoco_ros2_control_plugins</exec_depend>
  <exec_depend>mujoco_3d_lidar</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>dynamixel_hardware</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>sobits_gazebo_worlds</exec_depend>
  <exec_depend>tmc_wrs_gz_worlds</exec_depend>
  <exec_depend>aws_small_house_world</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
