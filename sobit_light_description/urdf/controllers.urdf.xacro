<?xml version="1.0" encoding="UTF-8" ?>
<!-- SOBIT LIGHT (Dynamixel Control) -->
<robot name="sobit_light_controllers" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="controllers" params="name enable_gz:=False robot_name:=sobit_light">

    <ros2_control name="dynamixel_controllers" type="system">
      <hardware>
        <xacro:if value="${$(arg enable_gz)}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${$(arg enable_gz)}">
          <xacro:property name="dxl_sl_port" value="$(arg dxl_sl_port)"/>
          <plugin>dynamixel_hardware/DynamixelHardware</plugin>
            <param name="port_name">${dxl_sl_port}</param>
            <param name="baud_rate">1000000</param>
        </xacro:unless>
      </hardware>

      <xacro:if value="${$(arg enable_head)}">
        <xacro:dxl_head_controllers prefix="head"  enable_gz="${$(arg enable_gz)}"/>
      </xacro:if>
      <xacro:if value="${$(arg enable_arm)}">
        <xacro:dxl_arm_controllers  prefix="arm"   enable_gz="${$(arg enable_gz)}"/>
      </xacro:if>
      <xacro:if value="${$(arg enable_hand)}">
        <xacro:dxl_hand_controllers prefix="hand"  enable_gz="${$(arg enable_gz)}"/>
      </xacro:if>
      <xacro:if value="${$(arg enable_mobile_base)}">
        <xacro:wheel_controllers    prefix="wheel" enable_gz="${$(arg enable_gz)}"/>
      </xacro:if>
    </ros2_control>


    <!-- Gazebo ROS2 Control -->
    <xacro:if value="${$(arg enable_gz)}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <ros>
            <namespace>$(arg robot_name)</namespace>
          </ros>
          <parameters>$(find sobit_light_control)/config/gz_controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>


  <xacro:macro name="dxl_head_controllers"  params="prefix enable_gz:=False">
    <!-- Position Drive - Head -->
    <joint name="${prefix}_yaw_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">11</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-${M_PI}</param>
        <param name="max">${M_PI}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <joint name="${prefix}_pitch_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">12</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">${HEAD_PITCH_MIN}</param>
        <param name="max">${HEAD_PITCH_MAX}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
  </xacro:macro>

  <xacro:macro name="dxl_arm_controllers"  params="prefix enable_gz:=False">
    <!-- Position Drive - Arm -->
    <joint name="${prefix}_shoulder_roll_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">1</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-${M_PI}</param>
        <param name="max">${M_PI}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <!-- <joint name="${prefix}_shoulder_pitch_sub_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">2</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <state_interface name="position">
        <param name="initial_value">${M_PI/2}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <xacro:unless value="${$(arg enable_gz)}">
        <command_interface name="position"/>
      </xacro:unless>
      <param name="mimic">${prefix}_shoulder_pitch_joint</param>
      <param name="multiplier">-1</param>
    </joint> -->
    <joint name="${prefix}_shoulder_pitch_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">3</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">${SHOULDER_PITCH_MIN}</param>
        <param name="max">${SHOULDER_PITCH_MAX}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-${M_PI/2}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <joint name="${prefix}_elbow_pitch_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">4</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">${ELBOW_PITCH_MIN}</param>
        <param name="max">${ELBOW_PITCH_MAX}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <joint name="${prefix}_forearm_roll_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">5</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-${M_PI}</param>
        <param name="max">${M_PI}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <joint name="${prefix}_wrist_pitch_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">6</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">${WRIST_PITCH_MIN}</param>
        <param name="max">${WRIST_PITCH_MAX}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <joint name="${prefix}_wrist_roll_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">7</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-${M_PI}</param>
        <param name="max">${M_PI}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
  </xacro:macro>

  <xacro:macro name="dxl_hand_controllers"  params="prefix enable_gz:=False">
    <!-- Position Drive - Hand -->
    <joint name="${prefix}_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">8</param>
        <param name="control_mode">6</param>
        <param name="Goal_Current">50</param>
        <param name="interface">rs</param>
        <param name="gear_ratio">-${HAND_GEAR_RATIO}</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <!-- <state_interface name="effort"/> -->
    </joint>
    <xacro:if value="${$(arg enable_gz)}">
      <joint name="${prefix}_sub_joint">
        <param name="mimic">${prefix}_joint</param>
        <param name="multiplier">-1</param>
        <!-- <command_interface name="position"/> -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <!-- <state_interface name="effort"/> -->
      </joint>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="wheel_controllers"  params="prefix enable_gz:=False">
    <xacro:if value="${$(arg enable_gz)}">
        <joint name="base_l_drive_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="base_r_drive_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
    </xacro:if>
  </xacro:macro>

</robot>
