<?xml version="1.0" encoding="UTF-8" ?>
<!-- SOBIT Light (Values) -->
<robot name="sobit_light_values" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.14159265359" />

  <!-- Dynamixel datasheet values @ 12V: stall torque [N·m], no-load speed [rad/s] -->
  <xacro:property name="XM540_W270_TORQUE"   value="10.6" />
  <xacro:property name="XM540_W270_VELOCITY" value="3.14" /> <!-- 30 rpm -->
  <xacro:property name="XM540_W150_TORQUE"   value="7.1" />
  <xacro:property name="XM540_W150_VELOCITY" value="5.24" /> <!-- 50 rpm -->
  <xacro:property name="XM430_W350_TORQUE"   value="4.1" />
  <xacro:property name="XM430_W350_VELOCITY" value="4.82" /> <!-- 46 rpm -->

  <!-- Hand: XM430-W350 drives the prismatic finger through this ratio [rad/m].
       Same value as gear_ratio in controllers.urdf.xacro (sign handled there). -->
  <xacro:property name="HAND_GEAR_RATIO" value="59.504383354" />

  <!-- Dynamixel position register -> rad (4096 ticks/rev, 2048 = 0 rad). Joint
       ranges below are the Min/Max Position Limit registers measured on the
       real robot (2026-09-10): ID2/3 450-3000, ID4 700-2850, ID6 1000-3400,
       ID12 1200-3150. Rolls (ID1/5/7), head yaw (ID11) and hand (ID8) are full range. -->
  <xacro:property name="DXL_TICK" value="${2*M_PI/4096}" />
  <xacro:property name="SHOULDER_PITCH_MIN" value="${(450-2048)*DXL_TICK}" />
  <xacro:property name="SHOULDER_PITCH_MAX" value="${(3000-2048)*DXL_TICK}" />
  <xacro:property name="ELBOW_PITCH_MIN"    value="${(700-2048)*DXL_TICK}" />
  <xacro:property name="ELBOW_PITCH_MAX"    value="${(2850-2048)*DXL_TICK}" />
  <xacro:property name="WRIST_PITCH_MIN"    value="${(1000-2048)*DXL_TICK}" />
  <xacro:property name="WRIST_PITCH_MAX"    value="${(3400-2048)*DXL_TICK}" />
  <xacro:property name="HEAD_PITCH_MIN"     value="${(1200-2048)*DXL_TICK}" />
  <xacro:property name="HEAD_PITCH_MAX"     value="${(3150-2048)*DXL_TICK}" />

  <!-- Scale applied to datasheet torque for URDF effort limits (same convention as sobit_home) -->
  <xacro:property name="effort_ratio" value="100.0" />

</robot>
