<?xml version="1.0" encoding="UTF-8" ?>
<!-- SOBIT Light (Gazebo) -->
<robot name="sobit_light_gazebo" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="gazebo_sensors" params="robot_name enable_gz_front_cam_color:=True enable_gz_back_cam_color:=True enable_gz_head_cam_color:=True enable_gz_head_cam_depth:=True enable_gz_hand_cam_color:=True enable_gz_hand_cam_depth:=True enable_gz_lidar:=True enable_gz_imu:=True">

    <!-- Sensor: Base Front Camera (Color) -->
    <xacro:if value="${enable_gz_front_cam_color}">
      <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
          <pose>0 0 0 0 0 0</pose>

          <ignition_frame_id>${robot_name}/imu_link</ignition_frame_id>
          <topic>${robot_name}/imu</topic>
          
          <always_on>1</always_on>
          <visualize>true</visualize>
          <update_rate>1</update_rate>
        </sensor>
      </gazebo>
    </xacro:if>


    <!-- [TODO] Sensor: Base Front Camera (Color) -->
    <!-- <gazebo reference="camera_front_link">
      <sensor name="base_front_camera_color" type="wideanglecamera">
        <pose>0 0 ${0.0175/2} ${M_PI/2} -${M_PI/2} 0 </pose>

        <gz_frame_id>${robot_name}/camera_front_link</gz_frame_id>
        <topic>${robot_name}/base_front_camera/color</topic>

        <always_on>1</always_on>
