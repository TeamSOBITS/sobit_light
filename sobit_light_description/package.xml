<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobit_light_description</name>
  <version>2.0.0</version>
  <description>SOBIT LIGHT xacro and urdf package</description>
  <maintainer email="kvalentincardenas@hotmail.com">Keith Valentin</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>

  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>

  <!-- Xacro includes and ros2_control / gz plugins referenced from the URDF. -->
  <exec_depend>realsense2_description</exec_depend>
  <exec_depend>kachaka_description</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>dynamixel_hardware</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>sobit_light_control</test_depend>
  <test_depend>sobits_robot_descriptor</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
