<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_light" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Add Common Xacro: transmissions, colors -->
  <xacro:include filename="$(find sobit_light_description)/urdf/values.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/materials.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/transmission.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/controllers.urdf.xacro" />


  <!-- Add URDF: links, joints -->
  <xacro:include filename="$(find sobit_light_description)/urdf/base/plate.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/arm/arm.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/hand/hand.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/back/back.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/head/head.urdf.xacro" />
  
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/camera_front.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/camera_back.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/camera_hand.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/camera_head.urdf.xacro" />

  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/lidar.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/tof.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/imu.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/mic.urdf.xacro" />
  <xacro:include filename="$(find sobit_light_description)/urdf/sensor/speaker.urdf.xacro" />


  <!-- Add URDF: gazebo -->
  <xacro:include filename="$(find sobit_light_description)/urdf/gazebo.urdf.xacro" />


  <!-- Add Kachaka -->
  <xacro:include filename="$(find kachaka_description)/urdf/_values.urdf.xacro" />
  <xacro:include filename="$(find kachaka_description)/urdf/_kachaka.urdf.xacro" />


  <!-- Add variables -->
  <xacro:arg name="enable_gz"                 default="False" />
  <xacro:arg name="enable_gz_front_cam_color" default="True" />
  <xacro:arg name="enable_gz_back_cam_color"  default="True" />
  <xacro:arg name="enable_gz_head_cam_color"  default="True" />
  <xacro:arg name="enable_gz_head_cam_depth"  default="True" />
  <xacro:arg name="enable_gz_hand_cam_color"  default="True" />
  <xacro:arg name="enable_gz_hand_cam_depth"  default="True" />
  <xacro:arg name="enable_gz_lidar"           default="True" />
  <xacro:arg name="enable_gz_imu"             default="True" />
  <xacro:arg name="robot_name"                default="sobit_light" />
  <!-- Must match the frame_prefix given to robot_state_publisher. -->
  <xacro:arg name="enable_tf_prefix"          default="True" />

  <!-- Activate Components -->
  <xacro:arg name="enable_mobile_base"  default="True" />
  <xacro:arg name="enable_head"         default="True" />
  <xacro:arg name="enable_arm"          default="True" />
  <xacro:arg name="enable_hand"         default="True" />

  <!-- DXL Ports -->
  <xacro:arg name="dxl_sl_port"  default="/dev/ttyUSB0" />


  <!-- Connect the Links and Joints -->
  <link name="base_footprint" />

  <xacro:if value="${$(arg enable_mobile_base)}">
    <xacro:kachaka_robot parent="base_footprint">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:kachaka_robot>
  </xacro:if>
  <xacro:unless value="${$(arg enable_mobile_base)}">
    <joint name="base_footprint_joint" type="fixed" >
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <parent link="base_footprint" />
      <child link="base_link" />
    </joint>
    <link name="base_link">
      <collision>
        <origin xyz="0.0435 0.0 0.0475"
                rpy="0 0 0" />
        <geometry>
          <box size="0.387 0.240 0.095" />
        </geometry>
      </collision>
    </link>
  </xacro:unless>

  <xacro:plate         prefix="plate"        parent="base_link" />

  <xacro:if value="${$(arg enable_arm)}">
    <xacro:arm         prefix="arm"          parent="plate_middle_link" />
  </xacro:if>
  <xacro:unless value="${$(arg enable_arm)}">
    <joint name="arm_wrist_roll_joint" type="fixed" >
      <origin xyz="${0.122+0.26624862} 0.0 0.18032586" rpy="0.0 0.0 0.0" />
      <parent link="plate_middle_link" />
      <child link="arm_wrist_roll_link" />
    </joint>
    <link name="arm_wrist_roll_link" />
  </xacro:unless>

  <xacro:if value="${$(arg enable_hand)}">
    <xacro:hand        prefix_hand="hand"    prefix_finger="finger" parent="arm_wrist_roll_link" />
    <xacro:camera_hand prefix="hand_camera"  parent="arm_wrist_roll_link" />
  </xacro:if>

  <xacro:if value="${$(arg enable_head)}">
    <xacro:back        prefix="back"         parent="plate_bottom_link" />
    <xacro:head        prefix="head"         parent="back_base_link" />
    <xacro:mic         prefix="mic"          parent="head_pitch_link" />
    <xacro:speaker     prefix="speaker"      parent="back_base_link" />
    <xacro:camera_head prefix="head_camera"  parent="head_pitch_link" />
  </xacro:if>


  <!-- Add Dynamixel: plugins -->
  <xacro:controllers name="joints_control" enable_gz="$(arg enable_gz)" robot_name="$(arg robot_name)" />


  <!-- Add Gazebo: plugins -->
  <xacro:if value="${$(arg enable_gz)}">
    <xacro:gazebo_sensors robot_name="$(arg robot_name)"
      enable_tf_prefix="$(arg enable_tf_prefix)"
      enable_gz_front_cam_color="$(arg enable_gz_front_cam_color)"
      enable_gz_back_cam_color="$(arg enable_gz_back_cam_color)"
      enable_gz_head_cam_color="$(arg enable_gz_head_cam_color)"
      enable_gz_head_cam_depth="$(arg enable_gz_head_cam_depth)"
      enable_gz_hand_cam_color="$(arg enable_gz_hand_cam_color)"
      enable_gz_hand_cam_depth="$(arg enable_gz_hand_cam_depth)"
      enable_gz_lidar="$(arg enable_gz_lidar)"
      enable_gz_imu="$(arg enable_gz_imu)"
    />
  </xacro:if>

</robot>
